@model Aula_05.Models.Categoria

@{
    ViewData["Title"] = "DeleteConfirmed";
}

<h1>DeleteConfirmed</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Categoria</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nome)
        </dd>
    </dl>
    <h4>Produtos</h4>
    <hr />
    @for (int i = 0; i < Model.Produtos.Count; i++)
    {
        <dl class="row">
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Produtos[i].Nome)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Produtos[i].Nome)
            </dd>
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Produtos[i].Preco)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Produtos[i].Preco)
            </dd>
            <dt class="col-sm-2 ">
                @Html.DisplayNameFor(model => model.Produtos[i].Ativo)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Produtos[i].Ativo)
            </dd>
        </dl>
    }


    
    <form asp-action="DeleteConfirmed">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
