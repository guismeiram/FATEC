@page "/cadastrar-produto"
@rendermode InteractiveServer 
@using Aula_11_Front.Models
@using Aula_11_Front.Services
@inject ProdutoService ProdutoService
@inject NavigationManager Navigation

<h3>Cadastrar Produto</h3>

@if (mensagemSucesso != null)
{
    <div class="alert alert-success">
        @mensagemSucesso
    </div>
}

@if (mensagemErro != null)
{
    <div class="alert alert-danger">
        <strong>Erro:</strong> @mensagemErro
    </div>
}

<div>
    <label>Nome do produto</label>
    <br />
    <input @bind="produto.Nome" placeholder="Nome do produto" />
</div>

<br />

<div>
    <label>Preço</label>
    <br />
    <input type="number" step="0.01" @bind="produto.Preco" placeholder="Preço" />
</div>

<br />

<button @onclick="SalvarProduto" disabled="@salvando">
    @(salvando ? "Salvando..." : "Salvar")
</button>

<button @onclick="Voltar" style="margin-left: 10px;">
    Voltar
</button>

@code {
    private Produto produto = new Produto();

    private string? mensagemSucesso;
    private string? mensagemErro;

    private bool salvando = false;

    private async Task SalvarProduto()
    {
        try
        {
            mensagemErro = null;
            mensagemSucesso = null;

            if (string.IsNullOrWhiteSpace(produto.Nome))
            {
                mensagemErro = "Informe o nome do produto.";
                return;
            }

            if (produto.Preco <= 0)
            {
                mensagemErro = "Informe um preço maior que zero.";
                return;
            }

            salvando = true;

            await ProdutoService.CadastrarProduto(produto);

            mensagemSucesso = "Produto cadastrado com sucesso!";

            produto = new Produto();
        }
        catch (Exception ex)
        {
            mensagemErro = ex.Message;
        }
        finally
        {
            salvando = false;
        }
    }

    private void Voltar()
    {
        Navigation.NavigateTo("/produtos");
    }
}