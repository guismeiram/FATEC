@model IEnumerable<Aula_04.Models.CategoriaProduto>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <table class="table">
        <thead> 
            <tr> 
                <th> @Html.DisplayNameFor(model => model.Categorias.NomeCategoria) </th> 
                <th> @Html.DisplayNameFor(model => model.Produtos.Preco) </th>
                <th> @Html.DisplayNameFor(model => model.Produtos.Ativo) </th> 
                <th> @Html.DisplayNameFor(model => model.Produtos.NomeProduto) </th> 
            </tr> 
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Categorias?.NomeCategoria</td>
                    <td>@item.Produtos?.Preco</td>
                    <td>@item.Produtos?.Ativo</td>
                    <td>@item.Produtos?.NomeProduto</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
    </tbody>
</table>
