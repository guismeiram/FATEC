@model Aula_04.Models.CategoriaProduto

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>CategoriaProduto</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">

            @for (int i = 0; i < Model.Categorias.Count; i++)
            {
                <div class="form-group">
                    <label asp-for="Produtos[i].Nome" class="control-label"></label>
                    <input asp-for="Produtos[i].Nome" class="form-control" />
                    <span asp-validation-for="Produtos[i].Nome" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Produtos[i].Preco" class="control-label"></label>
                    <input asp-for="Produtos[i].Preco" class="form-control" />
                    <span asp-validation-for="Produtos[i].Preco" class="text-danger"></span>
                </div>
                <div class="form-group form-check">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="Produtos[i].Ativo" /> @Html.DisplayNameFor(model => model.Produtos[i].Ativo)
                    </label>
                </div>
                <hr />
            }

            @for (int i = 0; i < Model.Produtos.Count; i++)
            {
                <div class="form-group">
                    <label asp-for="Produtos[i].Nome" class="control-label"></label>
                    <input asp-for="Produtos[i].Nome" class="form-control" />
                    <span asp-validation-for="Produtos[i].Nome" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Produtos[i].Preco" class="control-label"></label>
                    <input asp-for="Produtos[i].Preco" class="form-control" />
                    <span asp-validation-for="Produtos[i].Preco" class="text-danger"></span>
                </div>
                <div class="form-group form-check">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="Produtos[i].Ativo" /> @Html.DisplayNameFor(model => model.Produtos[i].Ativo)
                    </label>
                </div>
                <hr />
            }
         
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
